# Manejo automático de finales de línea para archivos de texto
* text=auto

# Archivos de código fuente con terminación estándar
*.php text eol=crlf
*.java text eol=crlf
*.js text eol=crlf
*.css text eol=crlf
*.html text eol=crlf
*.xml text eol=crlf
*.jrxml text eol=crlf
*.json text eol=crlf
*.md text eol=crlf

# Archivos binarios que no deben ser modificados por Git
*.jar binary
*.jasper binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.class binary
